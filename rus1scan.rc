    CONTROL         "Take no action",IDC_RADIO_NOTHING,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,86,127,64,10
    CONTROL         "Save picture to this folder:",IDC_RADIO_SAVEFOLDER,
                    "Button",BS_AUTORADIOBUTTON | WS_TABSTOP,86,143,98,10
    EDITTEXT        IDC_EDIT_FOLDER,104,158,145,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_BUTTON_BROWSE,255,158,50,14
    PUSHBUTTON      "OK",IDOK,177,200,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,233,200,50,14
